# Copy to .env and fill in. Never commit .env.
# The API will refuse to start if CNC_PASSPHRASE is unset.

CNC_PASSPHRASE=change-me
CNC_SERIAL_PORT=/dev/ttyACM0
CNC_SERIAL_BAUD=115200
CNC_SERIAL_OPEN_DELAY_SECONDS=2.0
CNC_MESSAGE_TIMEOUT_PER_COMMAND=1.0
CNC_MAX_COMMAND_LENGTH=500
CNC_MAX_REPEAT=100
CNC_SIMULATOR=false
CNC_LOCK_WAIT_SECONDS=60
